{
  "name": "Minima",
  "extension": "dracula-theme.theme-dracula",
  "settings": {
    "workbench.colorCustomizations": {
      "[Dracula]": {
        "focusBorder": "#C80050",
        "button.background": "#C80050",
        "button.hoverBackground": "#A00040",
        "textLink.foreground": "#C80050",
        "textLink.activeForeground": "#A00040",
        "editorCursor.foreground": "#C80050",
        "terminalCursor.foreground": "#C80050",
        "editorLineNumber.activeForeground": "#C80050",
        "list.highlightForeground": "#C80050",
        "progressBar.background": "#C80050",
        "editorWidget.border": "#C80050",
        "pickerGroup.foreground": "#C80050",
        "tab.activeBorder": "#C80050",
        "notificationLink.foreground": "#C80050"
      }
    }
  }
}
